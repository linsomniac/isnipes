# Keep the build context small and deterministic. *_test.go is NOT excluded
# (the go build ignores test files anyway, and excluding them would break a
# `go test` run inside a derived image).
.git
.github
node_modules
web/node_modules
web/dist
web/coverage
cmd/isnipes/dist
isnipes
.codex
.phase-loop-notes.md
*.md
deploy

# Never ship local credentials into the build context (defense in depth;
# COPY . . in the build stage would otherwise ingest them into builder
# layers/cache). The deploy guide has operators keep TLS cert/key files
# near the repo for --require-tls.
*.pem
*.key
*.crt
.env
.env.*
.npmrc
.netrc
